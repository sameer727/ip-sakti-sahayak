# ==============================================================================
# IP-SAKTI Sahayak — Environment Configuration
# ==============================================================================
# Choose ONE of the options below. By default, if no API keys are provided,
# the system uses deterministic offline generation (evidence quotes only).

# ------------------------------------------------------------------------------
# OPTION 0: Experiential Labs API Gateway (gpt-5.6-luna)
# Set your API key under Settings -> API Keys and export EXPLABS_API_KEY:
# ------------------------------------------------------------------------------
# EXPLABS_API_KEY=xpl_your_key_here
# LLM_BASE_URL=https://api.experientiallabs.ai/v1
# LLM_MODEL=gpt-5.6-luna

# ------------------------------------------------------------------------------
# OPTION 1: Groq Cloud (RECOMMENDED FREE TIER — FASTEST & 100% FREE)
# Get a free key in 30 seconds at: https://console.groq.com/keys
# ------------------------------------------------------------------------------
# GROQ_API_KEY=gsk_your_groq_api_key_here
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile

# ------------------------------------------------------------------------------
# OPTION 2: Google Gemini (FREE TIER VIA OPENAI-COMPATIBLE ENDPOINT)
# Get a free key at: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
# GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# OPTION 3: OpenRouter (FREE MODELS)
# Get a key at: https://openrouter.ai/keys
# ------------------------------------------------------------------------------
# OPENROUTER_API_KEY=sk-or-your_openrouter_key
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ------------------------------------------------------------------------------
# OPTION 4: Built-in Local Free API Server (NO KEYS NEEDED AT ALL)
# Run `python free_api_server.py` in a separate terminal and enable this:
# ------------------------------------------------------------------------------
# FREE_API=1
# LLM_BASE_URL=http://127.0.0.1:8001/v1
# LLM_MODEL=free-ayurveda-llm

# ------------------------------------------------------------------------------
# OPTION 5: Standard OpenAI / Any OpenAI-Compatible Provider
# ------------------------------------------------------------------------------
# LLM_API_KEY=sk-your_openai_key
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# Member-specific overrides (optional — each falls back to LLM_* above if not set)
# M3_LLM_API_KEY=
# M4_LLM_API_KEY=
# OPENAI_API_KEY=

# ------------------------------------------------------------------------------
# Bhashini — National Language Translation Mission (MeitY / DIBD / ULCA)
# Access & keys: https://bhashini.gov.in/ulca
# ------------------------------------------------------------------------------
# BHASHINI_USER_ID=your_bhashini_user_id
# BHASHINI_API_KEY=your_bhashini_udyat_or_ulca_api_key
# BHASHINI_INFERENCE_KEY=your_bhashini_inference_authorization_key
# BHASHINI_PIPELINE_ID=64392f96daac500b55c543cd

